{
  "lock": true,
  "nodeModulesDir": "manual",
  "fmt": {
    "proseWrap": "preserve",
    "useTabs": false,
    "indentWidth": 2
  },
  "tasks": {
    "setup": "deno install --allow-scripts && deno task genapi",
    "genapi": "cd api && deno task genapi",
    "dev": "deno -A npm:vitepress dev docs",
    "build": "deno -A npm:vitepress build docs && deno task sitemap",
    "serve": "deno -A npm:vitepress serve docs",
    "preview": "deno task build && deno task serve",
    "test": "deno test -E -R=deno.jsonc,docs/README.md,node_modules docs/.vitepress/components/live-code",
    "lint": "deno lint && deno -ERS --allow-scripts npm:markdownlint-cli2 \"./docs/**/*.md\" \"#./docs/ref\"",
    "sitemap": "deno -R=docs/.vitepress/dist -W=docs/.vitepress/dist/sitemap.xml jsr:@knorpelsenf/sitemap@1.2.4/cli -b https://grammy.dev -r docs/.vitepress/dist --clean",
    "links:check": "deno --reload -E=DEBUG,GITHUB_API_ROOT,GITHUB_TOKEN -NR=docs,. --allow-run=deno https://raw.githubusercontent.com/grammyjs/link-checker/main/website_cli.ts --clean-url docs",
    "links:fix": "deno --reload -E=DEBUG,GITHUB_API_ROOT,GITHUB_TOKEN -NR=. -W=docs --allow-run=deno https://raw.githubusercontent.com/grammyjs/link-checker/main/website_cli.ts --clean-url --fix docs"
  },
  "imports": {
    "@jridgewell/trace-mapping": "npm:@jridgewell/trace-mapping@0.3.31",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@vueuse/core": "npm:@vueuse/core@^14.3.0",
    "$types/markdown-it": "npm:@types/markdown-it@^14.1.2",
    "country-flag-emoji-polyfill": "npm:country-flag-emoji-polyfill@^0.1.8",
    "es-module-lexer": "npm:es-module-lexer@3.0.2",
    "grammy": "npm:grammy@1.46.0",
    "lazy-lottie-player": "npm:lazy-lottie-player@^0.0.1",
    "markdownlint-cli2": "npm:markdownlint-cli2@^0.22.1",
    "prism-code-editor": "npm:prism-code-editor@5.4.0",
    "sass": "npm:sass@^1.101.0",
    "sucrase": "npm:sucrase@3.35.1",
    "vitepress": "npm:vitepress@^1.6.4",
    "vue": "npm:vue@^3.5.38"
  },
  "exclude": [
    "node_modules",
    "api/.cache",
    "docs/.vitepress/cache",
    "docs/.vitepress/.temp",
    "docs/.vitepress/dist",
    "docs/ref"
  ],
  "lint": {
    "rules": {
      "exclude": [
        "jsx-curly-braces"
      ]
    }
  }
}
